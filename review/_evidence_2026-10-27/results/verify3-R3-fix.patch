+// signLog is this validator's write-ahead record of what it signed at the height in progress: its
+// own votes, plus the proposal of the round it last precommitted a value in (so after a restart it
+// can still decide or re-propose what it is locked on). It is made durable BEFORE a vote is released
+// and replayed on restart (Driver.Resume), so an honest reboot mid-height can neither sign a second,
+// conflicting vote nor forget its lock. It lives next to the snapshot.
+type signLog struct {
+	Height int64
+	Votes  []consensus.Vote
+	Locked *ProposalMsg
+}
+
+func (n *Node) signLogPath() string {
+	if n.cfg.SnapshotPath == "" {
+		return ""
+	}
+	return n.cfg.SnapshotPath + ".votes"
+}
+
+// persistVote appends an own vote to the current height's sign log and fsyncs it. false means it is
+// not durable, and the caller must not release the vote.
+func (n *Node) persistVote(v consensus.Vote) bool {
+	path := n.signLogPath()
+	if path == "" {
+		return true // no persistence configured: amnesia on restart (validators should set snapshotPath)
+	}
+	if n.sign.Height != n.height {
+		n.sign = signLog{Height: n.height}
+	}
+	n.sign.Votes = append(n.sign.Votes, v)
+	if v.Type == consensus.Precommit && v.BlockDigest != ([32]byte{}) {
+		if p, ok := n.heightProposals[v.Round]; ok && p.Block.StateDigest == v.BlockDigest {
+			n.sign.Locked = &p
+		}
+	}
+	data, err := json.Marshal(n.sign)
+	if err != nil {
+		return false
+	}
+	return writeAtomic(path, path+".tmp", data) == nil
+}
