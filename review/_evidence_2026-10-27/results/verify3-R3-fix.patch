+// Resume re-enters this height after a crash, from the validator's OWN votes that were made durable
+// before release (the node's sign log). Each is re-counted and marked sent, so the driver can never
+// sign a second, different vote for the same (round, type); the lock (and valid value) is restored
+// from the highest-round non-nil precommit -- this driver locks exactly when it precommits a value --
+// and the driver resumes at the latest round it voted in, never earlier. Without this a restart is
+// amnesia: an honest node re-enters round 0 unlocked and can complete a conflicting quorum.
+func (d *Driver) Resume(own []Vote) []Action {
+	r := int32(0)
+	for _, v := range own {
+		if v.Height != d.height || v.Validator != d.self || v.Round < 0 {
+			continue
+		}
+		d.ensureRound(v.Round)
+		switch v.Type {
+		case Prevote:
+			d.prevotes[v.Round].Add(d.scheme, d.networkID, v)
+			d.sentPrevote[v.Round] = true
+		case Precommit:
+			d.precommits[v.Round].Add(d.scheme, d.networkID, v)
+			d.sentPrecommit[v.Round] = true
+			if v.BlockDigest != nilDigest && (d.lockedValue == nil || v.Round > d.lockedRound) {
+				d.lockedValue, d.lockedRound = digestPtr(v.BlockDigest), v.Round
+				d.validValue, d.validRound = digestPtr(v.BlockDigest), v.Round
+			}
+		default:
+			continue
+		}
+		if v.Round > r {
+			r = v.Round
+		}
+	}
+	return d.startRound(r)
+}
