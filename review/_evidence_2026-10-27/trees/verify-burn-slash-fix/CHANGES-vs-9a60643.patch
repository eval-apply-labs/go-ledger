+// IsBurned reports whether key is in the (sorted) burned set.
+func IsBurned(burned []string, key string) bool {
+	i := sort.SearchStrings(burned, key)
+	return i < len(burned) && burned[i] == key
+}
+
+func burnedUnion(burned []string, add []string) []string {
+	if len(add) == 0 {
+		return burned
+	}
+	out := append([]string(nil), burned...)
+	for _, k := range add {
+		if !IsBurned(out, k) {
+			out = append(out, k)
+			sort.Strings(out)
+		}
+	}
+	return out
