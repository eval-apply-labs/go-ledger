+// touchesAccount (TRIAL C12 exclusion) reports whether a payment debits or credits `account`, its
+// recipient resolved against the pre-block registry exactly as ProcessPayments resolves it.
+func touchesAccount(registry map[string]string, payment Payment, account string) bool {
