+// paymentTouches reports whether p debits or credits `account` (payee resolved pre-block).
+func paymentTouches(registry map[string]string, p Payment, account string) bool {
+	if p.PublicKeyFrom == account {
+		return true
+	}
+	to, ok := resolveRecipient(registry, p)
+	return ok && to == account
