+
+// amountScale fixes the smallest money unit at 10^-8: every amount (payment, cost, genesis balance,
+// reassignment) must be an integer multiple of it, so every balance's denominator divides 10^8 and
+// its encoding is bounded by the supply's digits (C08). A constant, not a governed parameter.
+var amountScale = new(big.Int).Exp(big.NewInt(10), big.NewInt(8), nil)
+
+// InUnits reports whether r is a non-nil integer multiple of the smallest money unit.
+func InUnits(r *big.Rat) bool {
+	return r != nil && new(big.Int).Rem(amountScale, r.Denom()).Sign() == 0
+}
 
